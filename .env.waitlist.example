# Private server variables. Copy to .env.local; never use VITE_ prefixes.
# Keep disabled until storage and the launch privacy details are ready.
WAITLIST_ENABLED=false
WAITLIST_REDIS_REST_URL=
WAITLIST_REDIS_REST_TOKEN=

# Configured localhost admin servers also support a private local waitlist.json.
# Public hosting requires the Redis settings above; no local fallback is enabled on public hosts.
