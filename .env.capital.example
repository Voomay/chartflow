# Copy to .env.local. These private values must never have a VITE_ prefix.
# Obtain credentials from a Capital.com DEMO account (2FA > API integrations).
# Enable only after all four market mappings have been verified for that account.
CAPITAL_INDEX_DATA=false
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

# Exact epics from Capital.com GET /api/v1/markets?searchTerm=...
# Choose the corresponding cash-index CFD, not an ETF, leveraged product or futures contract.
CAPITAL_EPIC_US30=
CAPITAL_EPIC_NAS100=
CAPITAL_EPIC_UK100=
CAPITAL_EPIC_GER30=
